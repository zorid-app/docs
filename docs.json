{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zorid",
  "colors": {
    "primary": "#6D28D9",
    "light": "#8B5CF6",
    "dark": "#5B21B6"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Product",
        "icon": "compass",
        "pages": [
          "product/overview",
          "product/frontend",
          "product/vision",
          "product/v1-features/templates",
          "product/v1-features/plugin-power-and-shell-ui-extensibility"
        ]
      },
      {
        "group": "Architecture",
        "icon": "cube",
        "pages": [
          "architecture/package-api-design",
          "architecture/kernel-and-plugin-host",
          "architecture/plugin-manifest",
          "architecture/storage-model",
          "architecture/index-schema",
          "architecture/fields-and-types",
          "architecture/zbase-schema",
          "architecture/neovim-lazy-comparison",
          "architecture/adr-0001-api-gated-vertical-architecture"
        ]
      },
      {
        "group": "Core plugins",
        "icon": "puzzle-piece",
        "pages": [
          "core-plugins/contract",
          "core-plugins/file-explorer",
          "core-plugins/search",
          "core-plugins/backlinks",
          "core-plugins/outline",
          "core-plugins/tags",
          "core-plugins/status-bar",
          "core-plugins/fields",
          "core-plugins/data-views"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "https://github.com/zorid-app/Zorid",
        "label": "GitHub"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Zorid",
      "href": "https://github.com/zorid-app/Zorid"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/zorid-app"
    }
  }
}
